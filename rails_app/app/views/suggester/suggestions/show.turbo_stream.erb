<turbo-stream action="replace" target="<%= @listbox_id %>">
  <template>
    <ol role="listbox" id="<%= @listbox_id %>">
      <% @actions&.each do |action| %>
        <li role="option" data-pl-value="<%= params[:q] %>" data-action-url="<%= action.url %>">
          <%= sanitize action.label, tags: %w[b] %>
        </li>
      <% end %>
      <% @completions&.each do |text| %>
        <li role="option"><%= sanitize text, tags: %w[b] %></li>
      <% end %>
    </ol>
  </template>
</turbo-stream>
