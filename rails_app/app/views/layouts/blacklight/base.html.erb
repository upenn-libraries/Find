<%
  # Up to date with Blacklight v9.0
%>
<!DOCTYPE html>
<%= content_tag :html, class: 'no-js', **html_tag_attributes do %>
  <head>
    <%= render('shared/google_analytics/tags', gtag_id: Settings.google_analytics.id) if Settings.google_analytics.id %>
    <meta charset="utf-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <%= render Catalog::MetaDescriptionComponent.new(document: @document) %>
    <title><%= render_page_title %></title>
    <%= opensearch_description_tag application_name, opensearch_catalog_url(format: 'xml') %>
    <%= favicon_link_tag %>
    <link rel="stylesheet" href="https://use.typekit.net/gbh8cmg.css">
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/@penn-libraries/web@#{Settings.pennlibs_web_version}/dist/web/web.css" %>
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" %>
    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "print", media: "print", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= javascript_import_module_tag "https://cdn.jsdelivr.net/npm/@penn-libraries/web@#{Settings.pennlibs_web_version}/dist/web/web.esm.js" %>
    <script>
        document.querySelector('html').classList.remove('no-js');
    </script>
    <%= csrf_meta_tags %>
    <%= content_for(:head) %>
  </head>
  <body class="<%= render_body_class %> pl-reset pl-typeset">
  <%= render('shared/ms_clarity/script', id: Settings.ms_clarity.id) if render_clarity_script? %>
  <%= render('shared/google_analytics/tags_noscript', gtag_id: Settings.google_analytics.id) if Settings.google_analytics.id %>
  <%= render blacklight_config.skip_link_component.new do %>
    <%= content_for(:skip_links) %>
  <% end %>
  <%= render blacklight_config.header_component.new(blacklight_config: blacklight_config, user: current_user) %>

  <%# The page's intro, under the site header: the breadcrumb on every page, and on a landing page the
      heading, lede, art and a larger search box. The breadcrumb renders here for every page, like the
      header does; pages add their own crumbs with the breadcrumb helper rather than rendering the
      component themselves. The stylesheet spots the art with :has, so there is no modifier to set. %>
  <div class="fi-intro fi-bg-subtle">
    <div class="fi-intro__inner-container pl-viewport-margins">
      <%= render BreadcrumbsComponent.new(crumbs: page_breadcrumbs) %>
      <% if content_for?(:intro_heading) %>
        <div class="fi-intro__content-container">
          <%= yield :intro_heading %>
        </div>
      <% end %>
      <%# A landing page's own intro search box. The header keeps its own too,
          so search sits in the same place on every page. %>
      <% if content_for?(:intro_search) %>
        <div class="fi-intro__search-container">
          <%= yield :intro_search %>
        </div>
      <% end %>
    </div>
    <%# Last, so the art's caption link comes after the breadcrumb, heading and search box when
        tabbing. The picture and caption are both positioned, so their place in the markup doesn't
        move them. %>
    <%= yield :intro_art %>
  </div>

  <%# Below the intro, on the page background rather than the intro's tint. On a landing page that puts
      it under the hero rather than under the breadcrumb, which is the trade we settled on. %>
  <% if flash.any? %>
    <div class="pl-viewport-margins">
      <%= render 'shared/flash_msg' %>
    </div>
  <% end %>

  <main id="main-container" class="<%= container_classes %>" aria-label="<%= t('blacklight.main.aria.main_container') %>">
    <%= content_for(:container_header) %>

    <div class="row">
      <%= content_for?(:content) ? yield(:content) : yield %>
    </div>
  </main>

  <%= render partial: 'shared/footer' %>
  <%= render partial: 'shared/modal' %>
  <%= content_for(:offcanvas) %>
  </body>
<% end %>