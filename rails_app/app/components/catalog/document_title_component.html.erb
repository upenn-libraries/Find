<%# Copied template from Blacklight v9.0 to show the detailed title and the vernacular title.
    Drops the gem's header wrapper, counter and actions, which the record page doesn't use, and keeps
    the gem's `as` and `classes` arguments so the caller still chooses the tag and the styling. %>

<%= content_tag @as, class: @classes do %>
  <span itemprop="name"><%= @presenter.document.detailed_title %></span>
  <% if @presenter.document.alternate_title.present? %>
    <br>
    <span class="record-alternate-title"><%= @presenter.document.alternate_title %></span>
  <% end %>
<% end %>
