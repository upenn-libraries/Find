<%
  # Copied from Blacklight v9.0
  # Adapted for the search box to be customized.
  # - "Find it" button label
  # - Center search box
  # - Rename advanced search link to match page heading
%>

<%# Ids are prefixed so a page can carry more than one search box (the home page has the header's and
    its own) without duplicating ids, which would be invalid and would point every label and
    "for" attribute at the first box on the page. %>
<% query_input_id = "#{@id_prefix}query_input" %>

<search>
  <div class="fi-search-box-container">
    <pennlibs-autocomplete for="<%= query_input_id %>" data-controller="suggester"<% if Settings.suggester.enabled %> data-suggester-enabled-value="true"<% end %>>
      <div slot="start">
        <%= form_with url: @url, local: true, method: @method, class: @classes.join(' '), scope: @prefix, role: 'search', **@form_options do |f| %>
          <%= render Blacklight::HiddenSearchStateComponent.new(params: @params) %>
          <% if search_fields.length > 1 %>
            <%= f.label :search_field, scoped_t('search_field.label'), class: 'visually-hidden' %>
          <% end %>
          <% before_input_groups.each do |input_group| %>
            <%= input_group %>
          <% end %>
          <div class="input-group">
            <%= prepend %>

            <% if search_fields.length > 1 %>
              <%= f.select(:search_field,
                          options_for_select(search_fields, h(@search_field)),
                          {},
                          title: scoped_t('search_field.title'),
                          class: "form-select search-field") %>
            <% elsif search_fields.length == 1 %>
              <%= f.hidden_field :search_field, value: search_fields.first.last %>
            <% end %>

            <%# The visually hidden label names the field. No aria-label here: a real label wins on
                voice control and translation, and it keeps one source for the name. %>
            <%= f.label @query_param, scoped_t('search.label'), for: query_input_id, class: 'visually-hidden' %>
            <%= f.search_field @query_param, value: @q, class: "search-q q form-control #{rounded_border_class}",
                autofocus: autofocus,
                autocomplete: 'off',
                placeholder: t('search.placeholder'),
                id: query_input_id
              %>

            <%= append %>
            <%= search_button || render(Catalog::SearchButtonComponent.new(id: "#{@id_prefix}#{@prefix}search", text: t('search.button.label'))) %>
          </div>
        <% end %>
      </div>
      <ol role="listbox" id="<%= @id_prefix %>suggestions-listbox"></ol>
    </pennlibs-autocomplete>
  </div>
</search>
